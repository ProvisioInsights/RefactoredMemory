# Copy outside the checkout; paths and nonsecret settings only.
REFMEM_PRIVATE_DIR=/srv/refactoredmemory
REFMEM_BACKUP_DIR=/srv/refactoredmemory-backups
REFMEM_IMAGE_TAG=local
REFMEM_UID=10001
REFMEM_GID=10001
REFMEM_MCP_HOST=memory.example.invalid
REFMEM_SYNC_HOST=memory-vm.example.invalid
# Change only after firewall/VLAN validation; never bind a public interface.
REFMEM_SYNC_BIND=127.0.0.1
REFMEM_SYNC_PORT=8766
REFMEM_MIN_FREE_BYTES=536870912
REFMEM_AUTH_HOST=auth.example.invalid
# Keycloak's admin authority includes its non-default published port.
REFMEM_AUTH_ADMIN_HOST=auth-admin.example.invalid:8443
REFMEM_AUTH_ADMIN_BIND=127.0.0.1
REFMEM_AUTH_ADMIN_PORT=8443
