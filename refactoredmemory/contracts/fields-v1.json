  "missingness": {
    "not_recorded": "Read projection only; do not submit a placeholder or unknown claim.",
    "unknown": "Explicit sourced unknown; null payload at the mapped value path.",
    "not_applicable": "Explicit sourced non-applicability; null payload at the mapped value path.",
    "coverage": [
      "withheld",
      "unavailable",
      "conflicted",
      "temporally-unresolved",
      "partial"
    ]
  },
  "validity_end": {
    "unknown": "valid_to must be explicitly null",
    "known": "valid_to must be a supported world timestamp/date",
    "ongoing": "valid_to must be omitted; this explicit declaration is required"
  },
  "normalization": "Validation only; no inferred identities, country codes, dates, current validity, profile ownership or factual verification.",
  "compatibility": "Original records and provenance are immutable; aliases are read/migration mappings, not automatic rewriting or identity merging.",
  "value_types": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536
    },
    "text_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "entity_type": {
      "enum": [
        "person",
        "organization",
        "project",
        "location",
        "occurrence",
        "topic",
        "offering",
        "item",
        "observation"
      ]
    },
    "entity_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "email": {
      "type": "string",
      "maxLength": 320,
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "phone_text": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[+0-9() .\\-xXeEtT#;/]+$",
      "description": "3 to 32 digits; source-reported formatting, no inferred country or reachability"
    },
    "http_url": {
      "type": "string",
      "maxLength": 65536,
      "format": "uri",
      "pattern": "^https?://",
      "description": "Core also requires a hostname, no credentials and no whitespace; storage never fetches this URL"
    },
    "calendar_date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
      "description": "Real calendar year/month/day with matching precision; does not set world validity"
    }
  },
  "investment_context": {
    "amount": "null for explicitly unknown, otherwise {value: nonnegative finite number, currency: explicit three-letter uppercase code}; no currency inferred",
    "investment_status": [
      "proposed",
      "discussed",
      "committed",
      "completed",
      "declined",
      "withdrawn",
      "unknown"
    ],
    "meaning": "An investment claim must display its source-reported status; proposed/discussed is not completed funding."
  },
  "creation": "A group with any v1 field tag and entity creation includes known identity.type and identity.name assertions agreeing with entity_type and label. Existing source records remain immutable.",
  "group_scope": "Typed ordinary entities require identity name/type in the group; capture-only source-document identities retain the existing observation/import contract.",
  "operations": {
    "create": "Atomic group containing identity plus sourced known type/name; contacts optional",
    "read": "Existing scoped query/entity/source/history/traversal tools",
    "update": "Existing submit/correct with retained field declaration and predecessor lineage",
    "relationship_reclassification": "Explicit withdrawal plus newly tagged replacement through existing correction tool",
    "remove": "Scoped retraction or explicit validity ending; evidence/history retained",
    "consumer_entity_archive": false,
    "permanent_erasure": false
  },
  "applicability": {
    "new_substantive_fields": "dependency frontier plus all type actions in the same atomic group; independent of wire order and respecting owner preference",
    "identity_type": "establish or resolve classification to a supported type; unresolved current classification does not block repair",
    "withdrawal": "Retain predecessor value/target, start, precision, uncertainty, value state and semantic qualifiers; retraction retains interval, invalidation only supplies supported end. A legacy ending cannot infer v1 qualification.",
    "reinstate": "normal current/resulting-type applicability applies"
  }
